__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/
.DS_Store
*.png
*.html
*.root
docs/_build_keynote.applescript
docs/assets/
docs/TRACE-HEP_Documentation.key
docs/build_keynote.py
docs/generate_doc_assets.py

# docs/site/ is the GitHub Pages showcase -- re-include it despite the
# blanket *.png/*.html ignores above (must come after them to win).
!docs/site/
!docs/site/**
# GitHub Pages serves from /docs itself, so its root needs an index.html
# (redirects to site/) and a .nojekyll (disables Jekyll for the whole tree).
!docs/index.html
!docs/.nojekyll
